<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>My CRUD in NodeJS</title>
</head>

<body>
    <h2>Registros</h2>
    <table border="1">
        <thead>
            <tr>
                <td>Nome</td>
                <td>cpf</td>
                <td>email</td>
                <td>telefone/td>
                <td>Ação</td>
            </tr>
        </thead>
        <tbody>
            <% crud.forEach(function(details) { %>
                <tr>
                    <td><%= details.nome %>
                    <td><%= details.cpf%>
                    <td><%= details.email%>
                    <td><%= details.telefone%>
                    <td><a href="/edit/<%= details._id %>">Editar</a> - <a href="/delete/<%= details._id %>">Deletar</a>
                    </td>
                </tr>
                <% }) %>
        </tbody>
    </table> <button><a href="/index">Novo</a></button>
</body>

</html>